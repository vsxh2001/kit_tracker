PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=changeme123

# Google OAuth2 — required to enable Google sign-in via setup_oauth.sh
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Set to 1 to disable Google OAuth provider in this environment
#GOOGLE_OAUTH_DISABLE=

# SMTP (admin notifications)
# For prod: use Gmail app password (smtp.gmail.com:587, TLS=true) or SendGrid/Mailgun
# For dev: leave SMTP_HOST=mailhog (set by docker-compose default)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=notifications@kit.local
SMTP_TLS=false
# Set to 1 to actively disable SMTP in PocketBase
#SMTP_DISABLE=
APP_BASE_URL=http://localhost:5173

# Telegram bot — slash-command interface + per-user event notifications.
# Create a bot via @BotFather. Set the webhook with scripts/tg-set-commands.sh (or curl setWebhook).
TELEGRAM_BOT_TOKEN=
# Shared secret returned in X-Telegram-Bot-Api-Secret-Token; pass to setWebhook secret_token.
TELEGRAM_BOT_SECRET=
# Optional: bot username (no @) — enables deep-link URL in /api/tg/link/code response.
TELEGRAM_BOT_USERNAME=
